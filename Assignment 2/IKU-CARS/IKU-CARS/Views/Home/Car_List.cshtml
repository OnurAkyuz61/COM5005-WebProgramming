@model IEnumerable<IKU_CARS.Models.Car>

@{
    ViewBag.Title = "Car List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 50px; margin-bottom: 50px;">
    <div class="row">
        <div class="col-md-12">
            <div class="titlepage">
                <h2>Available Cars</h2>
                <span>Choose from our wide selection of rental cars</span>
            </div>
        </div>
    </div>

    <div class="row">
        @foreach (var car in Model)
        {
            <div class="col-md-6" style="margin-bottom: 30px;">
                <div class="car_list_item" style="border: 1px solid #ddd; padding: 20px; border-radius: 10px; background: white;">
                    <div class="row">
                        <div class="col-md-4">
                            @if (!string.IsNullOrEmpty(car.CImage))
                            {
                                <img src="~/Images/Car_Images/@car.CImage" alt="@car.Maker @car.Model" style="width: 100%; height: 120px; object-fit: cover; border-radius: 5px;" />
                            }
                            else
                            {
                                <img src="~/Images/car_img1.png" alt="@car.Maker @car.Model" style="width: 100%; height: 120px; object-fit: cover; border-radius: 5px;" />
                            }
                        </div>
                        <div class="col-md-8">
                            <h3 style="color: #333; margin-bottom: 10px;">@car.Maker @car.Model</h3>
                            <p style="margin-bottom: 5px;"><strong>Year:</strong> @car.Year</p>
                            <p style="margin-bottom: 5px;"><strong>Type:</strong> @car.CType</p>
                            <p style="margin-bottom: 10px;"><strong>Price:</strong> $@car.Price</p>
                            
                            @if (car.CAvailable)
                            {
                                <p style="color: green; font-weight: bold; margin-bottom: 15px;">Car is Available</p>
                            }
                            else
                            {
                                <p style="color: red; font-weight: bold; margin-bottom: 15px;">Car is not Available</p>
                            }
                            
                            <div class="sign_btn">
                                @Html.ActionLink("Car Information", "Car_Info", "Home", new { id = car.Id }, new { @class = "btn", style = "background: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; display: inline-block;" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="row">
            <div class="col-md-12 text-center">
                <h3>No cars available at the moment.</h3>
                <p>Please check back later or contact us for more information.</p>
            </div>
        </div>
    }
</div>
