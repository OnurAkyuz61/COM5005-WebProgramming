@model IKU_CARS.Models.Car

@{
    ViewBag.Title = "Car Information";
}

<div class="container" style="margin-top: 50px; margin-bottom: 50px;">
    <div class="row">
        <div class="col-md-12">
            <div class="titlepage">
                <h2>Car Information</h2>
                <span>Detailed information about @Model.Maker @Model.Model</span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.CImage))
            {
                <img src="~/Images/Car_Images/@Model.CImage" alt="@Model.Maker @Model.Model" style="width: 100%; height: 300px; object-fit: cover; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);" />
            }
            else
            {
                <img src="~/Images/car_img1.png" alt="@Model.Maker @Model.Model" style="width: 100%; height: 300px; object-fit: cover; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);" />
            }
        </div>
        <div class="col-md-6">
            <div class="car_info_details" style="padding: 20px; background: #f8f9fa; border-radius: 10px; height: 300px;">
                <h3 style="color: #333; margin-bottom: 20px; border-bottom: 2px solid #007bff; padding-bottom: 10px;">@Model.Maker @Model.Model</h3>
                
                <div class="info_row" style="margin-bottom: 15px;">
                    <strong style="color: #555; display: inline-block; width: 100px;">Maker:</strong>
                    <span style="color: #333;">@Model.Maker</span>
                </div>
                
                <div class="info_row" style="margin-bottom: 15px;">
                    <strong style="color: #555; display: inline-block; width: 100px;">Model:</strong>
                    <span style="color: #333;">@Model.Model</span>
                </div>
                
                <div class="info_row" style="margin-bottom: 15px;">
                    <strong style="color: #555; display: inline-block; width: 100px;">Year:</strong>
                    <span style="color: #333;">@Model.Year</span>
                </div>
                
                <div class="info_row" style="margin-bottom: 15px;">
                    <strong style="color: #555; display: inline-block; width: 100px;">Type:</strong>
                    <span style="color: #333;">@Model.CType</span>
                </div>
                
                <div class="info_row" style="margin-bottom: 15px;">
                    <strong style="color: #555; display: inline-block; width: 100px;">Price:</strong>
                    <span style="color: #333; font-size: 18px; font-weight: bold;">$@Model.Price</span>
                </div>
                
                <div class="info_row" style="margin-bottom: 20px;">
                    <strong style="color: #555; display: inline-block; width: 100px;">Status:</strong>
                    @if (Model.CAvailable)
                    {
                        <span style="color: green; font-weight: bold;">Car is Available</span>
                    }
                    else
                    {
                        <span style="color: red; font-weight: bold;">Car is not Available</span>
                    }
                </div>
                
                <div class="action_buttons" style="margin-top: 30px;">
                    <div class="sign_btn" style="display: inline-block; margin-right: 10px;">
                        @Html.ActionLink("Back to List", "Car_List", "Home", null, new { @class = "btn" })
                    </div>
                    @if (Model.CAvailable)
                    {
                        <div class="sign_btn" style="display: inline-block;">
                            @Html.ActionLink("Reserve Now", "Create", "Cars", null, new { @class = "btn" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
