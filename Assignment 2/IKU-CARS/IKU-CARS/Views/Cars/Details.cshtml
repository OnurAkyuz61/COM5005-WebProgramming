@model IKU_CARS.Models.Car

@{
    ViewBag.Title = "Car Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 100px; margin-bottom: 50px;">
    <div class="row">
        <div class="col-md-12">
            <div class="titlepage text-center">
                <h2 style="color: #333; margin-bottom: 30px;">CAR DETAILS</h2>
                <span style="color: #666;">Detailed information about @Model.Maker @Model.Model</span>
            </div>
        </div>
    </div>

    <div class="row" style="margin-top: 50px;">
        <div class="col-md-5">
            @if (!string.IsNullOrEmpty(Model.CImage))
            {
                <img src="~/Images/Car_Images/@Model.CImage" alt="@Model.Maker @Model.Model" style="width: 100%; height: 350px; object-fit: cover; border-radius: 15px; box-shadow: 0 8px 25px rgba(0,0,0,0.15);" />
            }
            else
            {
                <img src="~/Images/car_img1.png" alt="@Model.Maker @Model.Model" style="width: 100%; height: 350px; object-fit: cover; border-radius: 15px; box-shadow: 0 8px 25px rgba(0,0,0,0.15);" />
            }
        </div>
        <div class="col-md-7">
            <div class="car_details" style="background: white; padding: 40px; border-radius: 15px; box-shadow: 0 8px 25px rgba(0,0,0,0.1); border: 1px solid #e9ecef; margin-left: 20px;">
                <div class="detail-item" style="margin-bottom: 25px; border-bottom: 1px solid #f1f1f1; padding-bottom: 15px;">
                    <strong style="color: #555; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Maker</strong>
                    <p style="color: #333; font-size: 18px; margin: 8px 0 0 0; font-weight: 600;">@Model.Maker</p>
                </div>

                <div class="detail-item" style="margin-bottom: 25px; border-bottom: 1px solid #f1f1f1; padding-bottom: 15px;">
                    <strong style="color: #555; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Model</strong>
                    <p style="color: #333; font-size: 18px; margin: 8px 0 0 0; font-weight: 600;">@Model.Model</p>
                </div>

                <div class="detail-item" style="margin-bottom: 25px; border-bottom: 1px solid #f1f1f1; padding-bottom: 15px;">
                    <strong style="color: #555; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Year</strong>
                    <p style="color: #333; font-size: 18px; margin: 8px 0 0 0; font-weight: 600;">@Model.Year</p>
                </div>

                <div class="detail-item" style="margin-bottom: 25px; border-bottom: 1px solid #f1f1f1; padding-bottom: 15px;">
                    <strong style="color: #555; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Car Type</strong>
                    <p style="color: #333; font-size: 18px; margin: 8px 0 0 0; font-weight: 600;">@Model.CType</p>
                </div>

                <div class="detail-item" style="margin-bottom: 25px; border-bottom: 1px solid #f1f1f1; padding-bottom: 15px;">
                    <strong style="color: #555; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Price</strong>
                    <p style="color: #28a745; font-size: 24px; margin: 8px 0 0 0; font-weight: bold;">$@Model.Price.ToString("N2")</p>
                </div>

                <div class="detail-item" style="margin-bottom: 0;">
                    <strong style="color: #555; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Availability</strong>
                    @if (Model.CAvailable)
                    {
                        <p style="color: #28a745; font-size: 18px; margin: 8px 0 0 0; font-weight: bold;">Available for Rent</p>
                    }
                    else
                    {
                        <p style="color: #dc3545; font-size: 18px; margin: 8px 0 0 0; font-weight: bold;">Not Available</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row" style="margin-top: 40px;">
        <div class="col-md-12 text-center">
            @Html.ActionLink("Edit", "Edit", "Cars", new { id = Model.Id }, new { @class = "btn", style = "background: #007bff; color: white; padding: 12px 30px; text-decoration: none; border-radius: 8px; margin: 0 10px; display: inline-block; font-weight: bold;" })
            @Html.ActionLink("Back to List", "Index", "Cars", null, new { @class = "btn", style = "background: #6c757d; color: white; padding: 12px 30px; text-decoration: none; border-radius: 8px; margin: 0 10px; display: inline-block; font-weight: bold;" })
        </div>
    </div>
</div>
