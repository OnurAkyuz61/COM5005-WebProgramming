@model IKU_CARS.Models.Car

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 100px; margin-bottom: 50px;">
    <div class="row">
        <div class="col-md-12">
            <div class="titlepage text-center">
                <h2 style="color: #333; margin-bottom: 30px;">CREATE NEW CAR</h2>
                <span style="color: #666;">Add a new car to the system</span>
            </div>
        </div>
    </div>

    <div class="row" style="margin-top: 40px;">
        <div class="col-md-8 offset-md-2">
            <div class="main_form" style="background: white; padding: 40px; border-radius: 15px; box-shadow: 0 8px 25px rgba(0,0,0,0.1); border: 1px solid #e9ecef;">
                @using (Html.BeginForm()) 
                {
                    @Html.AntiForgeryToken()
                    
                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="form-group" style="margin-bottom: 25px;">
                            @Html.LabelFor(model => model.Maker, htmlAttributes: new { @class = "control-label", style = "font-weight: bold; color: #333; margin-bottom: 8px; display: block;" })
                            @Html.EditorFor(model => model.Maker, new { htmlAttributes = new { @class = "form-control", style = "padding: 12px; border: 2px solid #e9ecef; border-radius: 8px; font-size: 14px;", @placeholder = "Enter car maker (e.g., Audi, BMW)" } })
                            @Html.ValidationMessageFor(model => model.Maker, "", new { @class = "text-danger", style = "font-size: 12px; margin-top: 5px;" })
                        </div>

                        <div class="form-group" style="margin-bottom: 25px;">
                            @Html.LabelFor(model => model.Model, htmlAttributes: new { @class = "control-label", style = "font-weight: bold; color: #333; margin-bottom: 8px; display: block;" })
                            @Html.EditorFor(model => model.Model, new { htmlAttributes = new { @class = "form-control", style = "padding: 12px; border: 2px solid #e9ecef; border-radius: 8px; font-size: 14px;", @placeholder = "Enter car model (e.g., R8, X5)" } })
                            @Html.ValidationMessageFor(model => model.Model, "", new { @class = "text-danger", style = "font-size: 12px; margin-top: 5px;" })
                        </div>

                        <div class="form-group" style="margin-bottom: 25px;">
                            @Html.LabelFor(model => model.Year, htmlAttributes: new { @class = "control-label", style = "font-weight: bold; color: #333; margin-bottom: 8px; display: block;" })
                            @Html.EditorFor(model => model.Year, new { htmlAttributes = new { @class = "form-control", style = "padding: 12px; border: 2px solid #e9ecef; border-radius: 8px; font-size: 14px;", @placeholder = "Enter year (e.g., 2023)" } })
                            @Html.ValidationMessageFor(model => model.Year, "", new { @class = "text-danger", style = "font-size: 12px; margin-top: 5px;" })
                        </div>

                        <div class="form-group" style="margin-bottom: 25px;">
                            @Html.LabelFor(model => model.CType, htmlAttributes: new { @class = "control-label", style = "font-weight: bold; color: #333; margin-bottom: 8px; display: block;" })
                            @Html.DropDownListFor(model => model.CType, ViewBag.CTypeList as SelectList, "Select Car Type", new { @class = "form-control", style = "padding: 12px; border: 2px solid #e9ecef; border-radius: 8px; font-size: 14px; height: auto; background: white; appearance: none; -webkit-appearance: none; -moz-appearance: none;" })
                            @Html.ValidationMessageFor(model => model.CType, "", new { @class = "text-danger", style = "font-size: 12px; margin-top: 5px;" })
                        </div>

                        <div class="form-group" style="margin-bottom: 25px;">
                            @Html.LabelFor(model => model.CImage, htmlAttributes: new { @class = "control-label", style = "font-weight: bold; color: #333; margin-bottom: 8px; display: block;" })
                            @Html.EditorFor(model => model.CImage, new { htmlAttributes = new { @class = "form-control", style = "padding: 12px; border: 2px solid #e9ecef; border-radius: 8px; font-size: 14px;", @placeholder = "e.g., Audi_R8.jpg" } })
                            @Html.ValidationMessageFor(model => model.CImage, "", new { @class = "text-danger", style = "font-size: 12px; margin-top: 5px;" })
                            <small class="form-text text-muted" style="font-size: 12px; color: #6c757d; margin-top: 5px;">Enter the filename of the car image (must be in Car_Images folder)</small>
                        </div>

                        <div class="form-group" style="margin-bottom: 25px;">
                            @Html.LabelFor(model => model.Price, htmlAttributes: new { @class = "control-label", style = "font-weight: bold; color: #333; margin-bottom: 8px; display: block;" })
                            @Html.EditorFor(model => model.Price, new { htmlAttributes = new { @class = "form-control", style = "padding: 12px; border: 2px solid #e9ecef; border-radius: 8px; font-size: 14px;", @step = "0.01", @placeholder = "Enter price (e.g., 45000)" } })
                            @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger", style = "font-size: 12px; margin-top: 5px;" })
                        </div>

                        <div class="form-group" style="margin-bottom: 30px;">
                            <label style="font-weight: bold; color: #333; margin-bottom: 8px; display: block;">
                                @Html.EditorFor(model => model.CAvailable, new { htmlAttributes = new { style = "margin-right: 8px; transform: scale(1.2);" } })
                                Car is Available for Rent
                            </label>
                            @Html.ValidationMessageFor(model => model.CAvailable, "", new { @class = "text-danger", style = "font-size: 12px; margin-top: 5px;" })
                        </div>

                        <div class="form-group text-center" style="margin-top: 40px;">
                            <input type="submit" value="Create Car" style="background: #28a745; color: white; padding: 15px 40px; border: none; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; transition: all 0.3s;" onmouseover="this.style.background='#218838'" onmouseout="this.style.background='#28a745'" />
                        </div>
                    </div>
                }

                <div class="sign_btn" style="margin-top: 20px;">
                    @Html.ActionLink("Back to List", "Index", "Cars", null, new { @class = "btn", style = "background: #6c757d; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;" })
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
