@model IKU_CARS.Models.Car

@{
    ViewBag.Title = "Delete";
}

<div class="container" style="margin-top: 50px; margin-bottom: 50px;">
    <div class="row">
        <div class="col-md-12">
            <div class="titlepage text-center">
                <h2 style="color: #333; margin-bottom: 15px;">DELETE</h2>
                <span style="color: #666; font-size: 16px;">Are you sure you want to delete this car?</span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.CImage))
            {
                <img src="~/Images/Car_Images/@Model.CImage" alt="@Model.Maker @Model.Model" style="width: 100%; height: 300px; object-fit: cover; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);" />
            }
            else
            {
                <img src="~/Images/car_img1.png" alt="@Model.Maker @Model.Model" style="width: 100%; height: 300px; object-fit: cover; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);" />
            }
        </div>
        <div class="col-md-6">
            <div class="car_details" style="background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); min-height: 300px; height: auto;">
                <h3 style="color: #d9534f; margin-bottom: 12px; font-size: 16px; text-align: center;">Delete Confirmation</h3>
                
                <div class="car-info" style="margin-top: 8px;">
                    <div class="info-row" style="display: flex; justify-content: space-between; margin-bottom: 6px; padding: 4px 0; border-bottom: 1px solid #f0f0f0;">
                        <strong style="color: #555; font-size: 13px;">Maker:</strong>
                        <span style="color: #333; font-size: 13px;">@Html.DisplayFor(model => model.Maker)</span>
                    </div>
                    <div class="info-row" style="display: flex; justify-content: space-between; margin-bottom: 6px; padding: 4px 0; border-bottom: 1px solid #f0f0f0;">
                        <strong style="color: #555; font-size: 13px;">Model:</strong>
                        <span style="color: #333; font-size: 13px;">@Html.DisplayFor(model => model.Model)</span>
                    </div>
                    <div class="info-row" style="display: flex; justify-content: space-between; margin-bottom: 6px; padding: 4px 0; border-bottom: 1px solid #f0f0f0;">
                        <strong style="color: #555; font-size: 13px;">Year:</strong>
                        <span style="color: #333; font-size: 13px;">@Html.DisplayFor(model => model.Year)</span>
                    </div>
                    <div class="info-row" style="display: flex; justify-content: space-between; margin-bottom: 6px; padding: 4px 0; border-bottom: 1px solid #f0f0f0;">
                        <strong style="color: #555; font-size: 13px;">Type:</strong>
                        <span style="color: #333; font-size: 13px;">@Html.DisplayFor(model => model.CType)</span>
                    </div>
                    <div class="info-row" style="display: flex; justify-content: space-between; margin-bottom: 6px; padding: 4px 0; border-bottom: 1px solid #f0f0f0;">
                        <strong style="color: #555; font-size: 13px;">Price:</strong>
                        <span style="color: #333; font-size: 15px; font-weight: bold;">@Html.DisplayFor(model => model.Price)</span>
                    </div>
                    <div class="info-row" style="display: flex; justify-content: space-between; margin-bottom: 6px; padding: 4px 0;">
                        <strong style="color: #555; font-size: 13px;">Status:</strong>
                        <span style="font-size: 13px;">
                            @if (Model.CAvailable)
                            {
                                <span style="color: green; font-weight: bold;">Available</span>
                            }
                            else
                            {
                                <span style="color: red; font-weight: bold;">Not Available</span>
                            }
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row" style="margin-top: 30px;">
        <div class="col-md-12 text-center">
            @using (Html.BeginForm()) {
                @Html.AntiForgeryToken()
                <div class="form-actions no-color">
                    <input type="submit" value="Delete" onclick="return confirm('Are you sure you want to delete this car?');" style="background: #dc3545; color: white; padding: 12px 30px; border: none; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; margin-right: 15px; transition: all 0.3s;" onmouseover="this.style.background='#c82333'" onmouseout="this.style.background='#dc3545'" />
                    @Html.ActionLink("Back to List", "Index", null, new { style = "background: #6c757d; color: white; padding: 12px 30px; text-decoration: none; border-radius: 8px; font-size: 16px; font-weight: bold; transition: all 0.3s;", onmouseover = "this.style.background='#5a6268'", onmouseout = "this.style.background='#6c757d'" })
                </div>
            }
        </div>
    </div>
</div>
