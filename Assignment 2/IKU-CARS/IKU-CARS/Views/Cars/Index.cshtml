@model IEnumerable<IKU_CARS.Models.Car>

@{
    ViewBag.Title = "Cars Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 100px; margin-bottom: 50px;">
    <div class="row">
        <div class="col-md-12">
            <div class="titlepage text-center">
                <h2 style="color: #333; margin-bottom: 30px;">CARS MANAGEMENT</h2>
                <span style="color: #666;">Manage all cars in the system</span>
            </div>
        </div>
    </div>

    <div class="row" style="margin: 30px 0;">
        <div class="col-md-12 text-center">
            <div class="sign_btn">
                @Html.ActionLink("Create New Car", "Create", "Cars", null, new { @class = "btn", style = "background: #007bff; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px; display: inline-block;" })
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="table-responsive">
                <table class="table table-striped table-bordered" style="background: white;">
                    <thead style="background-color: #007bff; color: white;">
                        <tr>
                            <th>Maker</th>
                            <th>Model</th>
                            <th>Year</th>
                            <th>CType</th>
                            <th>CImage</th>
                            <th>Price</th>
                            <th>CAvailable</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Maker)</td>
                                <td>@Html.DisplayFor(modelItem => item.Model)</td>
                                <td>@Html.DisplayFor(modelItem => item.Year)</td>
                                <td>@Html.DisplayFor(modelItem => item.CType)</td>
                                <td>@Html.DisplayFor(modelItem => item.CImage)</td>
                                <td>@Html.DisplayFor(modelItem => item.Price)</td>
                                <td>
                                    @if (item.CAvailable)
                                    {
                                        <span style="color: green; font-weight: bold;">Available</span>
                                    }
                                    else
                                    {
                                        <span style="color: red; font-weight: bold;">Not Available</span>
                                    }
                                </td>
                                <td>
                                    @Html.ActionLink("Edit", "Edit", "Cars", new { id = item.Id }, new { @class = "btn btn-sm", style = "background: #28a745; color: white; padding: 5px 10px; text-decoration: none; border-radius: 3px; margin: 2px;" })
                                    @Html.ActionLink("Details", "Details", "Cars", new { id = item.Id }, new { @class = "btn btn-sm", style = "background: #17a2b8; color: white; padding: 5px 10px; text-decoration: none; border-radius: 3px; margin: 2px;" })
                                    @Html.ActionLink("Delete", "Delete", "Cars", new { id = item.Id }, new { @class = "btn btn-sm", style = "background: #dc3545; color: white; padding: 5px 10px; text-decoration: none; border-radius: 3px; margin: 2px;" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="row">
            <div class="col-md-12 text-center">
                <h3>No cars found.</h3>
                <p>Start by creating your first car.</p>
            </div>
        </div>
    }
</div>
